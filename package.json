{
  "name": "lotext",
  "productName": "LoText",
  "version": "1.0.8",
  "description": "A folder-based plain-text editor. One window is one folder; one file is open at a time.",
  "main": "dist/main.js",
  "bundleId": "com.lolekproductions.lotext",
  "author": "Josh McCarty",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "pdf": "electron . --pdf",
    "test": "vitest run",
    "test:watch": "vitest",
    "dmg": "bash scripts/make-dmg.sh",
    "release": "bash scripts/release.sh",
    "windows": "bash scripts/make-windows.sh",
    "web:build": "node build.mjs --web",
    "ios:build": "node build.mjs --mobile && npx cap sync ios && sed -i '' 's#node_modules\\.nosync/#node_modules/#' ios/App/CapApp-SPM/Package.swift",
    "ios:sim": "bash scripts/ios-sim.sh run",
    "ios:open": "npm run ios:build && npx cap open ios",
    "android:build": "bash scripts/android.sh build",
    "android:run": "bash scripts/android.sh run",
    "android:open": "bash scripts/android.sh build && npx cap open android",
    "dependencies": "node scripts/keep-node-modules-out-of-icloud.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "resedit": "^3.1.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.3"
  },
  "overrides": {
    "yauzl": "^3.2.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
