<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- LoText's blue, the accent in src/renderer/style.css, for the system's dialogs and pickers. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#3478F6</item>
        <item name="colorPrimaryDark">#3478F6</item>
        <item name="colorAccent">#3478F6</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorPrimary">#3478F6</item>
        <item name="colorAccent">#3478F6</item>
    </style>

    <!-- The launch screen: LoText's icon on the sidebar's colour, until the page is up. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
