<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime has to allow for Electron to run at all. Notarization requires the
  hardened runtime, and under it V8 cannot generate code without these two: allow-jit for the
  JIT, allow-unsigned-executable-memory for the WebAssembly and regexp tiers that still map
  writable-executable pages. Applied to the app and to every helper app, since the renderers
  run V8 too. Nothing else is asked for — the app has no camera, microphone or sandbox needs.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
