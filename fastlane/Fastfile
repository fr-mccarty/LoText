# Google Play from the command line. The text and images are fastlane/metadata/android/; what
# Play Console asks for besides them (data safety, content rating) is packaging/play-store/listing.md.
default_platform(:android)

platform :android do
  desc "Check the service account key reaches Play Console"
  lane :check do
    validate_play_store_json_key
  end

  desc "Upload the store listing text and images, with no build"
  lane :listing do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true
    )
  end

  desc "Upload the release bundle to the internal testing track, as a draft"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      aab: "android/app/build/outputs/bundle/release/app-release.aab"
    )
  end

  desc "Upload the release bundle to production, as a draft: Play Console sends it for review"
  lane :production do
    upload_to_play_store(
      track: "production",
      release_status: "draft",
      aab: "android/app/build/outputs/bundle/release/app-release.aab"
    )
  end

  desc "Promote a build already on internal testing to production, as a draft (version_code:N)"
  lane :promote do |options|
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: "draft",
      version_code: options[:version_code] || UI.user_error!("fastlane promote version_code:N"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
