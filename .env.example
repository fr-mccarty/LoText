# Copy to .env (gitignored) and fill in only what you need. Read by scripts/load-env.sh; a variable already set in
# the environment wins.

# Publishing to the website (scripts/publish-to-website.sh, scripts/update-website-editor.sh):
# the ssh login for the machine with the Peru checkout. Not needed on that machine itself.
LOTEXT_PERU_HOST=user@host
# The checkout, relative to that machine's home folder.
LOTEXT_PERU_DIR=peru-2

# Signing a release (npm run release). Unset, it signs as Lolek Productions' Developer ID.
# LOTEXT_SIGN_IDENTITY=Developer ID Application: Your Name (TEAMID)
# LOTEXT_NOTARY_PROFILE=lotext-notary
